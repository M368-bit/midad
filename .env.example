# ====================================================================
# مشروع مداد | MIDAD — متغيرات البيئة (Environment Variables)
# ====================================================================

# 1. إعدادات Supabase (احصل عليها من لوحة تحكم مشروعك في supabase.com)
# عنوان URL لمشروع Supabase الخاص بك:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# المفتاح العام الآمن (Anon Key) للواجهة الأمامية:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# المفتاح السري للخادم فقط (Service Role Key) - لا تكشفه للعميل:
# يُستخدم للعمليات الإدارية على الخادم والتحقق الأمني فقط
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. إعدادات عنوان المنصة (URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. إعدادات تكامل الحديث الشريف والمصادر
# واجهة API المعتمدة للحديث الشريف (افتراضياً: واجهة المصادر المفتوحة المعتمدة لصحيح البخاري ومسلم)
NEXT_PUBLIC_HADITH_API_BASE=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1
